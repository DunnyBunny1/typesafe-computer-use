# Required: Jev action selection (TypeSafe) plus at least one planner/writer provider.
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Optional fallback providers; only configured keys are used.
# ANTHROPIC_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=

# Restrict these lists to control which providers receive page text/screenshots.
CLICKER_PLANNER_PROVIDERS=openai,openrouter,anthropic,fireworks
CLICKER_WRITER_PROVIDERS=openai,anthropic,fireworks,openrouter
CLICKER_PLANNER_REASONING=low

# See docs/writer-endpoints.md for model and custom endpoint overrides.
# CLICKER_PLANNER_OPENAI_MODEL=gpt-5.4-mini
# CLICKER_OPENAI_MODEL=gpt-4.1-nano
